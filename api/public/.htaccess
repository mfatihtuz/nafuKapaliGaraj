# DEPO — Apache yönlendirme (Hostinger paylaşımlı hosting)
# Yerleşim: public_html/depo_yonetimi/

Options -Indexes -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /depo_yonetimi/

    # private/ klasörüne HTTP erişimini engelle (yedek — private/.htaccess de var)
    RewriteRule ^private/ - [F,L]

    # API istekleri → front controller (ve API_REQ ortam değişkeniyle işaretle:
    # aşağıda bu isteklere no-store başlığı basılır — bayat bootstrap/pull önlenir)
    RewriteRule ^api/ index.php [L,QSA,E=API_REQ:1]

    # Gerçek dosya/dizin varsa doğrudan sun (assets, ikonlar, manifest, sw.js…)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Kalan her şey SPA'ya (React Router client-side yönlendirme: /l/:code, /search…)
    RewriteRule ^ index.html [L]
</IfModule>

# --- Güvenlik başlıkları ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # API yanıtları ASLA cache'lenmesin (PHP başlığına ek Apache güvencesi).
    # Bayat /api/sync/bootstrap yanıtı çıkış/giriş sonrası eski ağacı döndürüyordu.
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=API_REQ
    Header always set Pragma "no-cache" env=API_REQ
</IfModule>

# --- Sıkıştırma (bootstrap/pull JSON büyük olabilir; ~%80 küçülür) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json application/javascript text/css text/html image/svg+xml
</IfModule>

# --- Statik varlık cache'i (Vite hash'li dosyalar) ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

# Service worker ve manifest cache'lenmemeli
<IfModule mod_headers.c>
    <FilesMatch "(sw\.js|manifest\.webmanifest|index\.html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# PHP hata gösterimini kapat (canlı)
php_flag display_errors off
